---
import "../styles/site.css";
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>Page not found — Nivra</title>
    <link rel="icon" href={`${base}icon.svg`} />
  </head>
  <body>
    <main class="container" style="padding-block: min(25vh, 180px)">
      <a class="brand" href={base}>
        <img src={`${base}icon.svg`} width="30" height="30" alt="" />
        Nivra
      </a>
      <h1 style="font-size:48px;margin-block:40px 20px">Page not found.</h1>
      <p style="margin-bottom:24px">
        This page may have moved. Head back to Nivra to find your way.
      </p>
      <a class="button primary" href={base}>
        Back to Nivra
      </a>
    </main>
  </body>
</html>
