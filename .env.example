CILO_PORT=3000
CILO_BIND_ADDRESS=127.0.0.1
# Set the browser-visible HTTPS origin when using a reverse proxy.
CILO_PUBLIC_URL=
# Optional comma-separated hostnames or IPs for LAN development, without ports.
CILO_DEV_ORIGINS=
# Server configuration only; restart after changes.
CILO_UPLOAD_LIMIT_MIB=25
# Optional external key: 64 random hexadecimal characters. Encryption is always enabled.
# CILO_ENCRYPTION_KEY=
# Or a mounted file containing exactly 32 raw key bytes.
# CILO_ENCRYPTION_KEY_FILE=/run/secrets/cilo-encryption-key
CILO_STORAGE_BACKEND=local
# S3-compatible storage: use a private, pre-created bucket.
CILO_S3_ENDPOINT=
CILO_S3_REGION=us-east-1
CILO_S3_BUCKET=
CILO_S3_ACCESS_KEY_ID=
CILO_S3_SECRET_ACCESS_KEY=
CILO_S3_PREFIX=cilo/
CILO_S3_FORCE_PATH_STYLE=true
# Encrypted full-instance backups: local (default), s3, or off.
CILO_BACKUP_BACKEND=local
# Defaults to CILO_DATA_DIR/backups. Use a separate disk for host-failure recovery.
CILO_BACKUP_DIR=
CILO_BACKUP_INTERVAL_HOURS=24
CILO_BACKUP_KEEP=7
# Independent backup destination; does not reuse media credentials.
CILO_BACKUP_S3_ENDPOINT=
CILO_BACKUP_S3_REGION=us-east-1
CILO_BACKUP_S3_BUCKET=
CILO_BACKUP_S3_ACCESS_KEY_ID=
CILO_BACKUP_S3_SECRET_ACCESS_KEY=
CILO_BACKUP_S3_PREFIX=cilo-backups/
CILO_BACKUP_S3_FORCE_PATH_STYLE=true
