CILO_PORT=3000
CILO_BIND_ADDRESS=127.0.0.1
# Set the browser-visible HTTPS origin when using a reverse proxy.
CILO_PUBLIC_URL=
# Optional comma-separated hostnames or IPs for LAN development, without ports.
CILO_DEV_ORIGINS=
# Server configuration only; restart after changes.
CILO_UPLOAD_LIMIT_MIB=25
CILO_STORAGE_BACKEND=local
# S3-compatible storage: use a private, pre-created bucket.
CILO_S3_ENDPOINT=
CILO_S3_REGION=us-east-1
CILO_S3_BUCKET=
CILO_S3_ACCESS_KEY_ID=
CILO_S3_SECRET_ACCESS_KEY=
CILO_S3_PREFIX=cilo/
CILO_S3_FORCE_PATH_STYLE=true
