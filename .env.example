# Set this when reusing an existing named Docker volume.
# NIVRA_DATA_VOLUME=existing-volume-name
NIVRA_PORT=3000
NIVRA_BIND_ADDRESS=127.0.0.1
# Set the browser-visible HTTPS origin when using a reverse proxy.
NIVRA_PUBLIC_URL=
# Optional comma-separated hostnames or IPs for LAN development, without ports.
NIVRA_DEV_ORIGINS=
# Server configuration only; restart after changes.
NIVRA_UPLOAD_LIMIT_MIB=25
# Optional external key: 64 random hexadecimal characters. Encryption is always enabled.
# NIVRA_ENCRYPTION_KEY=
# Or a mounted file containing exactly 32 raw key bytes.
# NIVRA_ENCRYPTION_KEY_FILE=/run/secrets/nivra-encryption-key
NIVRA_STORAGE_BACKEND=local
# S3-compatible storage: use a private, pre-created bucket.
NIVRA_S3_ENDPOINT=
NIVRA_S3_REGION=us-east-1
NIVRA_S3_BUCKET=
NIVRA_S3_ACCESS_KEY_ID=
NIVRA_S3_SECRET_ACCESS_KEY=
NIVRA_S3_PREFIX=nivra/
NIVRA_S3_FORCE_PATH_STYLE=true
# Encrypted full-instance backups: local (default), s3, or off.
NIVRA_BACKUP_BACKEND=local
# Defaults to NIVRA_DATA_DIR/backups. Use a separate disk for host-failure recovery.
NIVRA_BACKUP_DIR=
NIVRA_BACKUP_INTERVAL_HOURS=24
NIVRA_BACKUP_KEEP=7
# Independent backup destination; does not reuse media credentials.
NIVRA_BACKUP_S3_ENDPOINT=
NIVRA_BACKUP_S3_REGION=us-east-1
NIVRA_BACKUP_S3_BUCKET=
NIVRA_BACKUP_S3_ACCESS_KEY_ID=
NIVRA_BACKUP_S3_SECRET_ACCESS_KEY=
NIVRA_BACKUP_S3_PREFIX=nivra-backups/
NIVRA_BACKUP_S3_FORCE_PATH_STYLE=true
