# Optional HTTPS origin when using a reverse proxy. Port defaults to 3000 on all interfaces.
NIVRA_PUBLIC_URL=

# Local files and daily local backups work without further configuration.
# To use S3 files, change local to s3 and fill in the connection below.
NIVRA_STORAGE_BACKEND=local
NIVRA_S3_ENDPOINT=
NIVRA_S3_BUCKET=
NIVRA_S3_ACCESS_KEY_ID=
NIVRA_S3_SECRET_ACCESS_KEY=
# true reuses this S3 connection for backups; false keeps backups local.
NIVRA_S3_BACKUP_ENABLED=false

# Encryption defaults on. Choose false only before a NEW installation's first startup.
# NIVRA_ENCRYPTION_ENABLED=false
# Advanced settings and existing-installation upgrades: docs/self-hosting.md.
