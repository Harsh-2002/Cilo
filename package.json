{
  "name": "nivra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-backup-cli.mjs && node scripts/verify-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "format": "prettier --write src tests scripts docs *.md *.json *.ts *.mjs .github/workflows/*.yml compose.yaml",
    "format:check": "prettier --check src tests scripts docs *.md *.json *.ts *.mjs .github/workflows/*.yml compose.yaml",
    "backup": "tsx scripts/backup-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@blocknote/code-block": "0.55.0",
    "@blocknote/core": "0.55.0",
    "@blocknote/diagram-block": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@blocknote/shadcn": "0.55.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/geist": "5.3.0",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs-precompiled": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@tesseract.js-data/eng": "1.0.0",
    "better-auth": "1.7.7",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@13.0.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "dompurify": "3.4.16",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "lucide-react": "1.52.0",
    "mermaid": "11.17.2",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "1.4.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3-multiple-ciphers@13.0.3": true
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid": "3.3.19",
